# ==============================================================================
# Email Configuration: Resend (https://resend.com)
# Add these in Vercel Dashboard under: Settings > Environment Variables
# ==============================================================================
RESEND_API_KEY=re_your_api_key_here
ADMIN_EMAIL=sparkeducationthika@gmail.com
# Optional: default is "SparkEd Inventors Camp <onboarding@resend.dev>"
# Once you verify your domain on Resend, you can use: SparkEd <info@yourdomain.com>
RESEND_FROM_EMAIL="Inventors Camp by SparkEd <noreply@resend.client.afribs.co.ke>"

# ==============================================================================
# Safaricom Daraja M-Pesa API Configuration
# ==============================================================================
# Environment: "sandbox" (for testing) or "production" (live payments)
DARAJA_ENVIRONMENT=sandbox

# Daraja App Credentials from https://developer.safaricom.co.ke
DARAJA_CONSUMER_KEY=your_daraja_consumer_key_here
DARAJA_CONSUMER_SECRET=your_daraja_consumer_secret_here

# Business Shortcode: SparkEd Paybill Number (4331541) or Sandbox (174379)
DARAJA_BUSINESS_SHORTCODE=4331541

# Passkey: Lipa na M-Pesa Online Passkey from Daraja portal
DARAJA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# Transaction Type: "CustomerPayBillOnline"
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline

# Webhook Callback URL: Where Safaricom will post payment confirmation
# Replace with your deployed Vercel domain, e.g. https://your-site.vercel.app/api/callback
DARAJA_CALLBACK_URL=https://your-domain.vercel.app/api/callback
